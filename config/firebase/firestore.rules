rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default: deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Quotes collection: read-only for verified iOS app
    match /quotes/{date} {
      allow read: if request.app != null
        && isValidDateKey(date)
        && hasRequiredFields();

      allow write: if false;
    }

    // Votes collection: read + increment writes from verified app
    match /votes/{date} {
      allow read: if request.app != null && isValidDateKey(date);
      allow write: if request.app != null && isValidDateKey(date);
    }
  }
}

// Validate document key is a valid date string (YYYY-MM-DD format)
function isValidDateKey(date) {
  return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
}

// Validate document has expected fields with correct types and sizes
function hasRequiredFields() {
  return resource != null
    && resource.data.keys().hasAll(['text', 'tone'])
    && resource.data.text is string
    && resource.data.text.size() > 0
    && resource.data.text.size() <= 500
    && resource.data.tone is string
    && resource.data.tone in ['humorous', 'serious'];
}
