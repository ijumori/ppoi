lane :submit_build7 do
  api_key = app_store_connect_api_key(
    key_id: "QYPK2U3FZ6",
    issuer_id: "70caad3c-77d8-4702-b9cc-24779b235dc5",
    key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_QYPK2U3FZ6.p8")
  )

  app_id = "6771264998"

  # Get app
  app = Spaceship::ConnectAPI::App.get(app_id: app_id)
  UI.message("App: #{app.name}")

  # Get edit version
  version = app.get_edit_app_store_version
  UI.message("Version: #{version.version_string} state=#{version.app_store_state}")

  # Find Build 7 using direct API call
  resp = Spaceship::ConnectAPI.get_builds(
    filter: { app: app_id, version: "7" }
  )
  build = resp.to_models.first
  UI.user_error!("Build 7 not found!") unless build
  UI.message("Build 7: id=#{build.id} processing=#{build.processing_state}")

  # Select build
  if version.build.nil?
    UI.message("Selecting Build 7...")
    version.select_build(build_id: build.id)
    UI.success("Build 7 selected!")
  else
    UI.message("Build already selected: #{version.build.version}")
  end

  # Cancel any unresolved submissions
  subs = Spaceship::ConnectAPI.get_review_submissions(
    app_id: app_id,
    filter: { state: "READY_FOR_REVIEW,WAITING_FOR_REVIEW,IN_REVIEW,UNRESOLVED_ISSUES" }
  ).to_models
  subs.each do |s|
    UI.message("Existing submission: #{s.id} state=#{s.state}")
    if s.state == "UNRESOLVED_ISSUES"
      Spaceship::ConnectAPI.patch_review_submission(
        review_submission_id: s.id,
        attributes: { canceled: true }
      )
      UI.message("Canceled.")
    end
  end

  # Create review submission
  UI.message("Creating review submission...")
  sub_resp = Spaceship::ConnectAPI.post_review_submission(
    app_id: app_id,
    platform: "IOS"
  )
  sub = sub_resp.to_models.first
  UI.message("Submission created: #{sub.id}")

  # Add version item
  Spaceship::ConnectAPI.post_review_submission_item(
    review_submission_id: sub.id,
    app_store_version_id: version.id
  )
  UI.message("Version item added.")

  # Submit for review
  Spaceship::ConnectAPI.patch_review_submission(
    review_submission_id: sub.id,
    attributes: { submitted: true }
  )
  UI.success("🎉 SUBMITTED FOR APP STORE REVIEW!")
end

# v1.3.0 (Build 12) を審査提出する。deliver は使わない（Deliverfile が
# build_number を上書きして誤ったビルドを選ぶため）。Build 12 を選び直し、
# 既存の空 review submission を再利用して提出する。実行:  fastlane submit_v13
lane :submit_v13 do
  app_store_connect_api_key(
    key_id: "QYPK2U3FZ6",
    issuer_id: "70caad3c-77d8-4702-b9cc-24779b235dc5",
    key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_QYPK2U3FZ6.p8")
  )
  app_id = "6771264998"
  build12_id = "181b0549-1e60-426e-9b3c-7d561404a7a4"
  app = Spaceship::ConnectAPI::App.get(app_id: app_id)
  version = app.get_edit_app_store_version

  # Once a version item has been added to a submission, the version is no
  # longer "editable" (get_edit_app_store_version returns nil). Handle both:
  # (a) version still editable -> prep build + free old rejection + add item;
  # (b) version already added   -> just submit the submission holding it.
  if version
    UI.important("Editable version #{version.version_string} build=#{version.build&.version}")
    version.select_build(build_id: build12_id) if version.build&.version != "12"

    Spaceship::ConnectAPI.get_review_submissions(
      app_id: app_id, filter: { state: "UNRESOLVED_ISSUES" }
    ).to_models.each do |s|
      Spaceship::ConnectAPI.patch_review_submission(review_submission_id: s.id, attributes: { canceled: true })
      UI.important("Canceled old rejected submission #{s.id}")
    end

    ready = Spaceship::ConnectAPI.get_review_submissions(app_id: app_id, filter: { state: "READY_FOR_REVIEW" }).to_models
    sub = ready.first || Spaceship::ConnectAPI.post_review_submission(app_id: app_id, platform: "IOS").to_models.first
    begin
      Spaceship::ConnectAPI.post_review_submission_item(review_submission_id: sub.id, app_store_version_id: version.id)
      UI.important("Version item added")
    rescue StandardError => e
      UI.important("add item note: #{e.message}")
    end
  else
    ready = Spaceship::ConnectAPI.get_review_submissions(app_id: app_id, filter: { state: "READY_FOR_REVIEW" }).to_models
    sub = ready.find do |s|
      Spaceship::ConnectAPI.get_review_submission_items(review_submission_id: s.id).to_models.any?
    end
    UI.user_error!("No submission with a version item found") unless sub
    UI.important("No editable version; submitting existing submission with item")
  end

  UI.important("Submitting review submission #{sub.id}")
  Spaceship::ConnectAPI.patch_review_submission(review_submission_id: sub.id, attributes: { submitted: true })
  UI.success("🎉 v1.3.0 (Build 12) SUBMITTED FOR APP STORE REVIEW!")
end
